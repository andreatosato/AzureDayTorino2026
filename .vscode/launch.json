{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AppHost - Aspire",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build AppHost",
      "program": "${workspaceFolder}\\src\\AppHost\\bin\\Debug\\net10.0\\AppHost.dll",
      "cwd": "${workspaceFolder}\\src\\AppHost",
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:15018",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
        "ASPIRE_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:19128",
        "ASPIRE_DASHBOARD_MCP_ENDPOINT_URL": "http://localhost:18030",
        "ASPIRE_RESOURCE_SERVICE_ENDPOINT_URL": "http://localhost:20079"
      }
    },
    {
      "name": "Attach .NET - Applicazioni Aspire",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": true
    }
  ]
}
