{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build demo .NET",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}\\AzureDayTorino2026.slnx"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Build AppHost",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}\\src\\AppHost\\AppHost.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Avvia AppHost",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}\\src\\AppHost", "--launch-profile", "http"],
      "problemMatcher": []
    }
  ]
}
